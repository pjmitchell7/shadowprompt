{
  "name": "shadowprompt-shelfday",
  "main": "server/shop_worker.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-workers",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  },
  "ai": { "binding": "AI" },
  "vars": {
    "FREE_ACCOUNT_VERIFIED": "true",
    "LIVE_ENABLED": "true"
  },
  "observability": { "enabled": false }
}
